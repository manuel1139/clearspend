{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "..",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["./**/*.ts", "../shared/**/*.ts"],
  "exclude": ["../src/**/*", "../dist/**/*", "../node_modules/**/*"]
}
